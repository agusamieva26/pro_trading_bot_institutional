modules = ["python-3.11"]
[agent]
expertMode = true
integrations = ["python_openai:1.0.0", "web_scraper:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["bash", "cargo", "gcc", "glibcLocales", "libiconv", "libxcrypt", "ocl-icd", "opencl-headers", "pkg-config", "rustc", "unzip", "xcodebuild", "xsimd", "zlib", "go"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Trading Bot"

[[workflows.workflow]]
name = "Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run dashboard_modern.py --server.port=5000 --server.address=0.0.0.0 --server.headless=true"
waitForPort = 5000

[[workflows.workflow]]
name = "Trading Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u -m bot.main"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80
